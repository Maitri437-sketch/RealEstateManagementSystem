@model RealEstateManagementSystem.ViewModels.ComparisonViewModel
@{
    ViewData["Title"] = "Property Comparison";
    var properties = Model.Properties;
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-arrow-left-right me-2"></i> Compare Properties</h1>
            <p class="text-white-50 mb-0">Evaluate up to four properties side-by-side to find the ideal match</p>
        </div>
        @if (properties.Any())
        {
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <form asp-action="Clear" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm" onclick="return confirm('Clear all comparison items?');">
                        <i class="bi bi-trash me-1"></i> Clear Comparison
                    </button>
                </form>
                <a asp-controller="Property" asp-action="Index" class="btn btn-light text-primary fw-bold btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add Another Listing
                </a>
            </div>
        }
    </div>
</div>

<div class="container pb-5">
    @if (properties.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 20%;" class="text-start">Feature</th>
                            @foreach (var p in properties)
                            {
                                var img = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                          ?? p.Images.FirstOrDefault()?.ImageUrl
                                          ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                                <th style="width: calc(80% / @properties.Count);" class="position-relative">
                                    <form asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-circle" title="Remove from comparison">
                                            &times;
                                        </button>
                                    </form>

                                    <img src="@img" class="rounded-3 mb-2" style="height: 140px; width: 100%; object-fit: cover;" alt="@p.Title">
                                    <h6 class="fw-bold mb-1">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="text-dark text-decoration-none">
                                            @p.Title
                                        </a>
                                    </h6>
                                    <div class="text-primary fw-bold fs-5 mb-1">$@p.Price.ToString("N0")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Property Type</td>
                            @foreach (var p in properties)
                            {
                                <td><span class="badge bg-secondary">@p.PropertyType</span></td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Listing Type</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <span class="badge @(p.ListingType == "Sale" ? "bg-success" : "bg-info")">
                                        For @p.ListingType
                                    </span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Price</td>
                            @foreach (var p in properties)
                            {
                                <td class="fw-bold fs-5 text-primary">
                                    $@p.Price.ToString("N0")
                                    @if (p.ListingType == "Rent")
                                    {
                                        <small class="fs-6 text-muted fw-normal">/ mo</small>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Bedrooms</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-door-closed text-primary me-1"></i> @p.Bedrooms Beds</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Bathrooms</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-droplet text-info me-1"></i> @p.Bathrooms Baths</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Square Footage</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-bounding-box text-success me-1"></i> @p.AreaSqFt.ToString("N0") sq ft</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Location / City</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-geo-alt text-danger me-1"></i> @p.City, @p.State</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Street Address</td>
                            @foreach (var p in properties)
                            {
                                <td class="small text-muted">@p.Address, @p.ZipCode</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Year Built</td>
                            @foreach (var p in properties)
                            {
                                <td>@(p.YearBuilt.HasValue ? p.YearBuilt.Value.ToString() : "N/A")</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Listing Status</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <span class="badge @(p.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">
                                        @p.Status
                                    </span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Actions</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <div class="d-grid gap-1">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary btn-sm fw-semibold">
                                            View Details
                                        </a>
                                        <a asp-controller="Appointment" asp-action="Book" asp-route-propertyId="@p.Id" class="btn btn-outline-secondary btn-sm">
                                            Book Tour
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-arrow-left-right display-3 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">No Properties in Comparison Table</h4>
            <p class="text-muted mb-4">You can select up to 4 properties from our catalog to compare their price, square footage, bedrooms, and amenities side-by-side.</p>
            <div>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-grid me-1"></i> Browse Properties
                </a>
            </div>
        </div>
    }
</div>
