@model RealEstateManagementSystem.ViewModels.ComparisonViewModel
@{
    ViewData["Title"] = "Property Comparison";
    var properties = Model.Properties;
}

<!-- Luxury Page Header -->
<div class="luxury-page-header">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <span class="badge bg-info-subtle text-info-emphasis px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">
                <i class="bi bi-arrow-left-right me-1"></i> Side-by-Side Analysis
            </span>
            <h1 class="h2 fw-bold mb-1">Compare Selected Properties</h1>
            <p class="text-white-50 mb-0">Evaluate up to four properties side-by-side across pricing, dimensions, and specifications</p>
        </div>
        @if (properties.Any())
        {
            <div class="mt-3 mt-md-0 d-flex gap-2">
                <form asp-action="Clear" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm" onclick="return confirm('Clear all comparison items?');">
                        <i class="bi bi-trash me-1"></i> Clear All
                    </button>
                </form>
                <a asp-controller="Property" asp-action="Index" class="btn btn-light text-primary fw-bold btn-sm shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add Another Listing
                </a>
            </div>
        }
    </div>
</div>

<div class="container pb-5">
    @if (properties.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 20%;" class="text-start fs-6 text-uppercase fw-bold text-muted">Feature</th>
                            @foreach (var p in properties)
                            {
                                var img = p.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                          ?? p.Images.FirstOrDefault()?.ImageUrl
                                          ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                                <th style="width: calc(80% / @properties.Count);" class="position-relative p-3">
                                    <form asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-circle shadow-sm" title="Remove from comparison">
                                            &times;
                                        </button>
                                    </form>

                                    <img src="@img" class="rounded-3 mb-2 shadow-sm" style="height: 150px; width: 100%; object-fit: cover;" alt="@p.Title">
                                    <h6 class="fw-bold mb-1 text-truncate">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="text-dark text-decoration-none">
                                            @p.Title
                                        </a>
                                    </h6>
                                    <div class="property-price mb-2">$@p.Price.ToString("N0")</div>
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary btn-sm w-100 fw-semibold">
                                        View Details
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Property Type</td>
                            @foreach (var p in properties)
                            {
                                <td><span class="badge bg-light text-dark border">@p.PropertyType</span></td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Listing Type</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <span class="badge @(p.ListingType == "Sale" ? "bg-success" : "bg-info")">
                                        For @p.ListingType
                                    </span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Price</td>
                            @foreach (var p in properties)
                            {
                                <td class="fw-bold fs-5 text-dark">
                                    $@p.Price.ToString("N0")
                                    @if (p.ListingType == "Rent")
                                    {
                                        <small class="fs-6 text-muted fw-normal">/ mo</small>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Bedrooms</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-door-closed text-primary me-1"></i> @p.Bedrooms Beds</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Bathrooms</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-droplet text-info me-1"></i> @p.Bathrooms Baths</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Square Footage</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-bounding-box text-secondary me-1"></i> @p.AreaSqFt.ToString("N0") sq ft</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Location / City</td>
                            @foreach (var p in properties)
                            {
                                <td><i class="bi bi-geo-alt text-danger me-1"></i> @p.City, @p.State</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Street Address</td>
                            @foreach (var p in properties)
                            {
                                <td class="small text-muted">@p.Address, @p.ZipCode</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Year Built</td>
                            @foreach (var p in properties)
                            {
                                <td>@(p.YearBuilt.HasValue ? p.YearBuilt.Value.ToString() : "N/A")</td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Listing Status</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <span class="badge @(p.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">
                                        @p.Status
                                    </span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-muted bg-light">Action</td>
                            @foreach (var p in properties)
                            {
                                <td>
                                    <a asp-controller="Appointment" asp-action="Book" asp-route-propertyId="@p.Id" class="btn btn-outline-primary btn-sm fw-semibold">
                                        <i class="bi bi-calendar2-check me-1"></i> Book Tour
                                    </a>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="rounded-circle bg-info-subtle text-info d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <h4 class="fw-bold">No Properties in Comparison</h4>
            <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">Compare multiple listings side-by-side to evaluate features, square footage, and pricing. Click the compare icon on any property card to add it here.</p>
            <div>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary fw-semibold px-4 shadow-sm">
                    <i class="bi bi-search me-1"></i> Browse Properties to Compare
                </a>
            </div>
        </div>
    }
</div>
