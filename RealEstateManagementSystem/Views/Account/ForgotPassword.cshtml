@model RealEstateManagementSystem.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                <div class="display-6 fw-bold"><i class="bi bi-key"></i> Reset Password</div>
                <p class="mb-0 text-white-50">Recover access to your RealEstate account</p>
            </div>
            <div class="card-body p-4 p-md-5">
                @if (ViewBag.MessageSent == true)
                {
                    <div class="text-center py-3">
                        <div class="text-success mb-3">
                            <i class="bi bi-envelope-check-fill display-3"></i>
                        </div>
                        <h4 class="fw-bold">Check Your Email</h4>
                        <p class="text-muted">
                            If an account exists for <strong>@ViewBag.SubmittedEmail</strong>, we have sent instructions to reset your password.
                        </p>
                        <a asp-action="Login" class="btn btn-primary mt-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-4">
                        Enter your registered email address and we'll send you a password reset link.
                    </p>

                    <form asp-action="ForgotPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" type="email" />
                            <label asp-for="Email"><i class="bi bi-envelope me-1"></i> Email Address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="bi bi-send me-2"></i> Send Reset Link
                            </button>
                            <a asp-action="Login" class="btn btn-light mt-2">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
