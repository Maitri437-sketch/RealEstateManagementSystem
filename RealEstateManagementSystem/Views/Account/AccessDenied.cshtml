@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5">
            <div class="mb-4 text-danger">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to view this resource. If you believe this is an error, please contact an administrator or log in with an authorized account.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
