@model RealEstateManagementSystem.ViewModels.PropertySearchViewModel
@{
    ViewData["Title"] = "Browse Properties";
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1">Explore Properties</h1>
            <p class="text-white-50 mb-0">Browse our comprehensive collection of verified homes and commercial real estate</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Agent") || User.IsInRole("Seller"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-controller="Property" asp-action="Create" class="btn btn-light text-primary fw-bold px-3">
                    <i class="bi bi-plus-circle-fill me-1"></i> List New Property
                </a>
            </div>
        }
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Search & Filter Sidebar -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-lg-top" style="top: 80px; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-funnel-fill text-primary me-2"></i> Filters</h5>
                    <a asp-action="Index" class="small text-decoration-none text-muted">Clear All</a>
                </div>

                <form asp-action="Index" method="get">
                    <!-- Keyword -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Search Keywords</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" asp-for="SearchTerm" class="form-control border-start-0" placeholder="Address, title..." />
                        </div>
                    </div>

                    <!-- City -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">City / Location</label>
                        <input type="text" asp-for="City" class="form-control" placeholder="e.g. Miami, Austin" />
                    </div>

                    <!-- Property Type -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Property Type</label>
                        <select asp-for="PropertyType" class="form-select">
                            <option value="">All Categories</option>
                            <option value="House">House</option>
                            <option value="Apartment">Apartment</option>
                            <option value="Villa">Luxury Villa</option>
                            <option value="Condo">Condo</option>
                            <option value="Commercial">Commercial</option>
                        </select>
                    </div>

                    <!-- Listing Type -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Offer Type</label>
                        <select asp-for="ListingType" class="form-select">
                            <option value="">Buy & Rent</option>
                            <option value="Sale">For Sale</option>
                            <option value="Rent">For Rent</option>
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Price Range ($)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" asp-for="MinPrice" class="form-control form-control-sm" placeholder="Min" />
                            </div>
                            <div class="col-6">
                                <input type="number" asp-for="MaxPrice" class="form-control form-control-sm" placeholder="Max" />
                            </div>
                        </div>
                    </div>

                    <!-- Bedrooms -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Bedrooms (Min)</label>
                        <select asp-for="MinBedrooms" class="form-select form-select-sm">
                            <option value="">Any</option>
                            <option value="1">1+ Beds</option>
                            <option value="2">2+ Beds</option>
                            <option value="3">3+ Beds</option>
                            <option value="4">4+ Beds</option>
                            <option value="5">5+ Beds</option>
                        </select>
                    </div>

                    <!-- Bathrooms -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Bathrooms (Min)</label>
                        <select asp-for="MinBathrooms" class="form-select form-select-sm">
                            <option value="">Any</option>
                            <option value="1">1+ Baths</option>
                            <option value="2">2+ Baths</option>
                            <option value="3">3+ Baths</option>
                            <option value="4">4+ Baths</option>
                        </select>
                    </div>

                    <!-- Sort Preservation Hidden Field -->
                    <input type="hidden" asp-for="SortBy" />

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="bi bi-filter me-1"></i> Apply Filters
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Property Grid & Results Header -->
        <div class="col-lg-9">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center bg-white p-3 rounded-4 border mb-4 shadow-sm">
                <div>
                    <span class="fw-bold text-dark fs-6">Showing @Model.Properties.Count of @Model.TotalItems Properties</span>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
                    <label class="small text-muted text-nowrap">Sort By:</label>
                    <form method="get" asp-action="Index" class="d-inline">
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="city" value="@Model.City" />
                        <input type="hidden" name="propertyType" value="@Model.PropertyType" />
                        <input type="hidden" name="listingType" value="@Model.ListingType" />
                        <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                        <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                        <input type="hidden" name="minBedrooms" value="@Model.MinBedrooms" />
                        <input type="hidden" name="minBathrooms" value="@Model.MinBathrooms" />

                        <select name="sortBy" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="area_desc" selected="@(Model.SortBy == "area_desc")">Largest Area (Sq Ft)</option>
                        </select>
                    </form>
                </div>
            </div>

            <!-- Property Cards Grid -->
            @if (Model.Properties != null && Model.Properties.Any())
            {
                <div class="row g-4">
                    @foreach (var property in Model.Properties)
                    {
                        var mainImage = property.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                        ?? property.Images.FirstOrDefault()?.ImageUrl
                                        ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";
                        var isWishlisted = Model.UserWishlistPropertyIds.Contains(property.Id);
                        var isCompared = Model.UserComparisonPropertyIds.Contains(property.Id);

                        <div class="col-md-6 col-xl-4">
                            <div class="property-card h-100 d-flex flex-column">
                                <div class="property-image-wrapper">
                                    <img src="@mainImage" alt="@property.Title" />
                                    <div class="property-badge-type">
                                        <span class="badge @(property.ListingType == "Sale" ? "bg-success" : "bg-info") shadow-sm px-2 py-1">
                                            For @property.ListingType
                                        </span>
                                        @if (property.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark shadow-sm px-2 py-1 ms-1">
                                                <i class="bi bi-star-fill"></i> Featured
                                            </span>
                                        }
                                    </div>
                                    <div class="property-actions-overlay">
                                        <a asp-controller="Wishlist" asp-action="Toggle" asp-route-propertyId="@property.Id" 
                                           class="btn-action @(isWishlisted ? "active" : "")" title="Save to Wishlist">
                                            <i class="bi @(isWishlisted ? "bi-heart-fill" : "bi-heart")"></i>
                                        </a>
                                        <a asp-controller="Comparison" asp-action="Add" asp-route-propertyId="@property.Id" 
                                           class="btn-action @(isCompared ? "text-primary" : "")" title="Compare Property">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="property-price">
                                            $@property.Price.ToString("N0")
                                            @if (property.ListingType == "Rent")
                                            {
                                                <small class="fs-6 text-muted fw-normal">/ mo</small>
                                            }
                                        </span>
                                        <span class="badge bg-light text-secondary border">@property.PropertyType</span>
                                    </div>

                                    <h5 class="fw-bold mb-1 text-truncate">
                                        <a asp-action="Details" asp-route-id="@property.Id" class="text-dark text-decoration-none">
                                            @property.Title
                                        </a>
                                    </h5>

                                    <p class="text-muted small mb-3 text-truncate">
                                        <i class="bi bi-geo-alt text-danger me-1"></i> @property.Address, @property.City, @property.State
                                    </p>

                                    <div class="d-flex justify-content-between py-2 border-top border-bottom mb-3 text-muted small">
                                        <span class="property-meta-item"><i class="bi bi-door-closed text-primary"></i> @property.Bedrooms Beds</span>
                                        <span class="property-meta-item"><i class="bi bi-droplet text-info"></i> @property.Bathrooms Baths</span>
                                        <span class="property-meta-item"><i class="bi bi-bounding-box text-secondary"></i> @property.AreaSqFt.ToString("N0") sqft</span>
                                    </div>

                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@property.Id" class="btn btn-primary w-100 btn-sm fw-semibold">
                                            View Details
                                        </a>
                                        <a asp-controller="Appointment" asp-action="Book" asp-route-propertyId="@property.Id" class="btn btn-outline-secondary btn-sm" title="Schedule Tour">
                                            <i class="bi bi-calendar-event"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5" aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-city="@Model.City"
                                   asp-route-propertyType="@Model.PropertyType"
                                   asp-route-listingType="@Model.ListingType"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-minBedrooms="@Model.MinBedrooms"
                                   asp-route-minBathrooms="@Model.MinBathrooms"
                                   asp-route-sortBy="@Model.SortBy">Previous</a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-currentPage="@p"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-city="@Model.City"
                                       asp-route-propertyType="@Model.PropertyType"
                                       asp-route-listingType="@Model.ListingType"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice"
                                       asp-route-minBedrooms="@Model.MinBedrooms"
                                       asp-route-minBathrooms="@Model.MinBathrooms"
                                       asp-route-sortBy="@Model.SortBy">@p</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-city="@Model.City"
                                   asp-route-propertyType="@Model.PropertyType"
                                   asp-route-listingType="@Model.ListingType"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-minBedrooms="@Model.MinBedrooms"
                                   asp-route-minBathrooms="@Model.MinBathrooms"
                                   asp-route-sortBy="@Model.SortBy">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="text-muted mb-3"><i class="bi bi-search display-3"></i></div>
                    <h4 class="fw-bold">No Properties Found</h4>
                    <p class="text-muted">We couldn't find any properties matching your current filters. Try resetting the criteria or exploring all categories.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-primary fw-semibold">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All Filters
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
