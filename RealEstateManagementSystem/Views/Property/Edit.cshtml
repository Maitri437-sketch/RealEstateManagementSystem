@model RealEstateManagementSystem.ViewModels.PropertyViewModel
@{
    ViewData["Title"] = "Edit Property - " + Model.Title;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h3 fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i> Edit Property Listing</h2>
                            <p class="mb-0 text-white-50">Update property details, add new images, or manage existing gallery photos</p>
                        </div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-eye me-1"></i> View Details
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SellerId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Basic Details Section -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Basic Information</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Title" class="form-label fw-bold small">Property Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PropertyType" class="form-label fw-bold small">Property Category <span class="text-danger">*</span></label>
                                <select asp-for="PropertyType" class="form-select">
                                    <option value="House">House (Single-Family)</option>
                                    <option value="Apartment">Apartment</option>
                                    <option value="Villa">Luxury Villa</option>
                                    <option value="Condo">Condominium</option>
                                    <option value="Commercial">Commercial Property</option>
                                </select>
                                <span asp-validation-for="PropertyType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ListingType" class="form-label fw-bold small">Listing Offer <span class="text-danger">*</span></label>
                                <select asp-for="ListingType" class="form-select">
                                    <option value="Sale">For Sale</option>
                                    <option value="Rent">For Rent</option>
                                </select>
                                <span asp-validation-for="ListingType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold small">Price ($) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AreaSqFt" class="form-label fw-bold small">Area (Square Feet) <span class="text-danger">*</span></label>
                                <input asp-for="AreaSqFt" type="number" class="form-control" />
                                <span asp-validation-for="AreaSqFt" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold small">Detailed Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Location Section -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Location Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold small">Street Address <span class="text-danger">*</span></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-bold small">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="State" class="form-label fw-bold small">State / Province <span class="text-danger">*</span></label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ZipCode" class="form-label fw-bold small">Zip / Postal Code <span class="text-danger">*</span></label>
                                <input asp-for="ZipCode" class="form-control" />
                                <span asp-validation-for="ZipCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Amenities & Dimensions -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Specifications</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Bedrooms" class="form-label fw-bold small">Bedrooms</label>
                                <input asp-for="Bedrooms" type="number" class="form-control" />
                                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Bathrooms" class="form-label fw-bold small">Bathrooms</label>
                                <input asp-for="Bathrooms" type="number" class="form-control" />
                                <span asp-validation-for="Bathrooms" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="YearBuilt" class="form-label fw-bold small">Year Built</label>
                                <input asp-for="YearBuilt" type="number" class="form-control" />
                                <span asp-validation-for="YearBuilt" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Existing Images Management -->
                        @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                        {
                            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">4. Existing Photos</h5>
                            <div class="row g-3 mb-4">
                                @foreach (var img in Model.ExistingImages)
                                {
                                    <div class="col-6 col-md-3">
                                        <div class="card border rounded-3 overflow-hidden position-relative">
                                            <img src="@img.ImageUrl" style="height: 120px; object-fit: cover;" class="card-img-top" alt="Property Photo">
                                            <div class="card-body p-2 text-center bg-light">
                                                @if (img.IsMain)
                                                {
                                                    <span class="badge bg-primary small d-block mb-1">Main Photo</span>
                                                }
                                                <button type="submit" asp-action="DeleteImage" 
                                                        asp-route-imageId="@img.Id" asp-route-propertyId="@Model.Id" 
                                                        class="btn btn-outline-danger btn-sm w-100 py-0" 
                                                        onclick="return confirm('Remove this image?');">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Upload Additional Images -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">5. Upload More Photos</h5>
                        <div class="mb-4">
                            <input asp-for="Images" type="file" multiple class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <small class="text-muted d-block mt-1">Select one or more new photos to append to this listing.</small>
                            <span asp-validation-for="Images" class="text-danger small"></span>
                        </div>

                        <!-- Admin / Status Controls -->
                        @if (User.IsInRole("Admin"))
                        {
                            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">6. Administrative Controls</h5>
                            <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                                <div class="col-md-4">
                                    <label asp-for="Status" class="form-label fw-bold small">Listing Status</label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Approved">Approved (Publicly Visible)</option>
                                        <option value="Pending">Pending Review</option>
                                        <option value="Rejected">Rejected</option>
                                        <option value="Sold">Sold</option>
                                        <option value="Rented">Rented</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="AgentId" class="form-label fw-bold small">Assigned Agent</label>
                                    <select asp-for="AgentId" asp-items="Model.Agents" class="form-select">
                                        <option value="">-- No Agent Assigned --</option>
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-center">
                                    <div class="form-check mt-3">
                                        <input asp-for="IsFeatured" class="form-check-input" />
                                        <label asp-for="IsFeatured" class="form-check-label fw-semibold">Feature on Home</label>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
