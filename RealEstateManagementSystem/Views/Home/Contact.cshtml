@{
    ViewData["Title"] = "Contact Us";
}

<!-- Contact Hero -->
<div class="bg-primary text-white py-5 mb-5">
    <div class="container text-center py-4">
        <span class="badge bg-light text-primary px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Get In Touch</span>
        <h1 class="display-4 fw-bold">We're Here to Help You</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 650px;">
            Have questions about a listing, interested in partnering with us, or need technical support? Send us a message anytime.
        </p>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="fw-bold mb-2">Send Us a Message</h3>
                <p class="text-muted small mb-4">Fill out the form below and one of our specialists will get back to you within 24 hours.</p>

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Your Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control form-control-lg fs-6" placeholder="John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control form-control-lg fs-6" placeholder="john@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Subject <span class="text-danger">*</span></label>
                            <input type="text" name="subject" class="form-control form-control-lg fs-6" placeholder="Inquiring about listing / General question" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Message <span class="text-danger">*</span></label>
                            <textarea name="message" class="form-control fs-6" rows="5" placeholder="How can our real estate team assist you?" required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4 shadow-sm">
                                <i class="bi bi-send me-1"></i> Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contact Information & Office Details -->
        <div class="col-lg-5">
            <div class="d-flex flex-column gap-4">
                <div class="p-4 bg-white rounded-4 border shadow-sm">
                    <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt-fill text-danger me-2"></i> Corporate Headquarters</h5>
                    <p class="text-muted mb-0">
                        100 Realty Boulevard, Suite 500<br />
                        Metro City, NY 10001<br />
                        United States
                    </p>
                </div>

                <div class="p-4 bg-white rounded-4 border shadow-sm">
                    <h5 class="fw-bold mb-3"><i class="bi bi-telephone-fill text-primary me-2"></i> Telephone & Inquiries</h5>
                    <p class="text-muted mb-1">
                        <strong>General:</strong> +1 (800) 555-REAL (7325)
                    </p>
                    <p class="text-muted mb-0">
                        <strong>Client Support:</strong> +1 (800) 555-7326
                    </p>
                </div>

                <div class="p-4 bg-white rounded-4 border shadow-sm">
                    <h5 class="fw-bold mb-3"><i class="bi bi-clock-fill text-info me-2"></i> Business Hours</h5>
                    <p class="text-muted mb-1">
                        <strong>Monday &ndash; Friday:</strong> 8:30 AM &ndash; 6:30 PM EST
                    </p>
                    <p class="text-muted mb-1">
                        <strong>Saturday:</strong> 9:00 AM &ndash; 4:00 PM EST
                    </p>
                    <p class="text-muted mb-0">
                        <strong>Sunday:</strong> Closed (Agent emergency line available)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
