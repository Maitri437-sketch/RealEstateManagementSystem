@{
    ViewData["Title"] = "About Us";
}

<!-- About Hero -->
<div class="bg-primary text-white py-5 mb-5">
    <div class="container text-center py-4">
        <span class="badge bg-light text-primary px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Who We Are</span>
        <h1 class="display-4 fw-bold">Connecting You to Your Ideal Property</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 700px;">
            We simplify real estate for buyers, sellers, and agents through innovation, verified listings, and transparent service.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Story & Mission -->
    <div class="row align-items-center mb-5 g-5">
        <div class="col-lg-6">
            <h6 class="text-primary text-uppercase fw-bold">Our Mission</h6>
            <h2 class="fw-bold mb-3">Redefining the Modern Real Estate Experience</h2>
            <p class="text-muted">
                Founded with the vision to modernize property transactions, RealEstate Management System connects clients looking for their dream homes with reputable sellers and experienced certified agents.
            </p>
            <p class="text-muted">
                Whether you are purchasing your first condominium, expanding your commercial footprint, or selling a family estate, our platform offers the tools, security, and guidance necessary for smooth, transparent transactions.
            </p>
            <div class="row g-3 mt-3">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border">
                        <i class="bi bi-shield-check text-primary fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Verified Quality</h6>
                            <small class="text-muted">Strict listing approval</small>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 border">
                        <i class="bi bi-people text-info fs-2"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Dedicated Support</h6>
                            <small class="text-muted">Agents by your side</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80" alt="About Real Estate" class="img-fluid rounded-4 shadow" />
        </div>
    </div>

    <!-- Numbers / Metrics -->
    <div class="p-5 bg-white rounded-4 border shadow-sm my-5 text-center">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <h2 class="display-5 fw-bold text-primary mb-1">15K+</h2>
                <p class="text-muted mb-0">Properties Listed</p>
            </div>
            <div class="col-md-3 col-6">
                <h2 class="display-5 fw-bold text-primary mb-1">98%</h2>
                <p class="text-muted mb-0">Customer Satisfaction</p>
            </div>
            <div class="col-md-3 col-6">
                <h2 class="display-5 fw-bold text-primary mb-1">250+</h2>
                <p class="text-muted mb-0">Licensed Agents</p>
            </div>
            <div class="col-md-3 col-6">
                <h2 class="display-5 fw-bold text-primary mb-1">$2.5B+</h2>
                <p class="text-muted mb-0">Properties Sold & Leased</p>
            </div>
        </div>
    </div>

    <!-- Values -->
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Our Pillars</span>
        <h2 class="fw-bold">Values That Guide Our Journey</h2>
    </div>

    <div class="row g-4 text-start">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100">
                <div class="stat-icon bg-primary text-white mb-3">
                    <i class="bi bi-transparency"></i>
                </div>
                <h5 class="fw-bold">Transparency First</h5>
                <p class="text-muted small mb-0">No hidden fees or misleading descriptions. We verify property records and validate seller credentials.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100">
                <div class="stat-icon bg-info text-white mb-3">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <h5 class="fw-bold">Speed & Efficiency</h5>
                <p class="text-muted small mb-0">From instant tour scheduling to instant client inquiries, our platform cuts weeks of paperwork down to clicks.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100">
                <div class="stat-icon bg-success text-white mb-3">
                    <i class="bi bi-heart"></i>
                </div>
                <h5 class="fw-bold">Customer Obsession</h5>
                <p class="text-muted small mb-0">Your satisfaction and peace of mind are our greatest rewards. We assist you long after the keys are handed over.</p>
            </div>
        </div>
    </div>
</div>
