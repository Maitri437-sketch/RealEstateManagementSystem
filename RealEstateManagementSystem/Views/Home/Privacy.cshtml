@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <!-- Header -->
    <div class="border-bottom pb-4 mb-5 text-center text-md-start">
        <h1 class="fw-bold text-dark display-5">@ViewData["Title"]</h1>
        <p class="text-muted lead mb-0">
            Learn how Grand Heights Residency collects, uses, and safeguards resident and visitor information.
        </p>
        <small class="text-secondary">Last updated: August 2026</small>
    </div>

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">1. Information We Collect</h4>
                    <p class="text-secondary">To ensure secure and efficient management of the housing society, we collect the following types of information:</p>
                    <ul class="text-secondary">
                        <li><strong>Resident Records:</strong> Flat/unit number, owner/tenant names, primary contact numbers, email addresses, and vehicle registration numbers.</li>
                        <li><strong>Visitor Logs:</strong> Visitor names, vehicle numbers, entry/exit timestamps, and visiting unit numbers recorded at security gates.</li>
                        <li><strong>Financial Information:</strong> Payment transaction references for monthly maintenance fees and community amenity bookings (note: credit card and banking details are processed directly via secure payment gateways and are never stored on our servers).</li>
                        <li><strong>CCTV Surveillance:</strong> Footage captured by security cameras installed across common society premises, entry gates, and parking areas.</li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">2. How We Use Your Data</h4>
                    <p class="text-secondary">The data gathered through the portal is strictly used for:</p>
                    <ul class="text-secondary">
                        <li>Validating resident identity for amenity access (pool, clubhouse, sports courts).</li>
                        <li>Automated maintenance billing, digital receipt generation, and ledger tracking.</li>
                        <li>Broadcasting emergency alerts, general body meeting (AGM) circulars, and maintenance notices.</li>
                        <li>Enhancing physical community security via gate pass authorization.</li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">3. Data Sharing & Confidentiality</h4>
                    <p class="text-secondary">
                        We respect your privacy. Resident contact information is <strong>never sold or rented</strong> to third-party commercial marketing agencies. Data is only disclosed when:
                    </p>
                    <ul class="text-secondary">
                        <li>Mandated by local law enforcement or municipal regulatory authorities.</li>
                        <li>Necessary for integrated third-party facility services (such as verified payment gateway providers and registered security vendor software).</li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <div class="card-body">
                    <h4 class="fw-bold text-primary mb-3">4. Security & Retention</h4>
                    <p class="text-secondary mb-0">
                        We implement role-based access control (RBAC) so that only authorized society management committee members and security desk personnel have access to resident logs. CCTV recordings are automatically overwritten every 30 to 60 days unless required for an ongoing investigation.
                    </p>
                </div>
            </div>
        </div>

        <!-- Sidebar / Contact Box -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm bg-light p-4 sticky-top" style="top: 2rem;">
                <h5 class="fw-bold text-dark mb-3">Management Office</h5>
                <p class="text-muted small mb-3">
                    Have questions regarding your personal data, directory listing, or privacy settings? Contact the management committee.
                </p>
                <div class="mb-2">
                    <span class="fw-bold text-dark d-block small">Office Address:</span>
                    <small class="text-secondary">Clubhouse Ground Floor, Grand Heights Residency</small>
                </div>
                <div class="mb-2">
                    <span class="fw-bold text-dark d-block small">Email:</span>
                    <small class="text-secondary">admin@grandheights.society</small>
                </div>
                <div class="mb-3">
                    <span class="fw-bold text-dark d-block small">Helpdesk Hours:</span>
                    <small class="text-secondary">Mon – Sat: 9:00 AM – 6:00 PM</small>
                </div>
                <a href="mailto:admin@grandheights.society" class="btn btn-primary btn-sm w-100">Send Privacy Inquiry</a>
            </div>
        </div>
    </div>
</div>
