@model List<RealEstateManagementSystem.Models.Inquiry>
@using System.Security.Claims
@{
    ViewData["Title"] = "Property Inquiries";
    var isClient = User.IsInRole("Client");
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-chat-left-dots-fill me-2"></i> Property Inquiries</h1>
            <p class="text-white-50 mb-0">Track conversations and questions between buyers, sellers, and agents</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Property" asp-action="Index" class="btn btn-light text-primary fw-bold">
                <i class="bi bi-search me-1"></i> Browse Properties
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        @if (Model != null && Model.Any())
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var inq in Model)
                {
                    var img = inq.Property?.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                              ?? inq.Property?.Images.FirstOrDefault()?.ImageUrl
                              ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                    <div class="border rounded-4 p-4 bg-light">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-3 pb-3 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@img" class="rounded-3" style="width: 80px; height: 60px; object-fit: cover;" alt="Property">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@inq.PropertyId" class="text-dark text-decoration-none">
                                            @(inq.Property?.Title ?? "Property Listing")
                                        </a>
                                    </h5>
                                    <span class="badge bg-primary me-2">Subject: @inq.Subject</span>
                                    <small class="text-muted"><i class="bi bi-clock"></i> @inq.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</small>
                                </div>
                            </div>
                            <div class="mt-2 mt-md-0">
                                <span class="badge @(inq.Status == "Responded" ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                                    Status: @inq.Status
                                </span>
                            </div>
                        </div>

                        <!-- Client Message -->
                        <div class="mb-3">
                            <div class="small fw-bold text-muted mb-1">
                                <i class="bi bi-person-fill text-primary"></i> @(inq.Client?.FullName ?? "Client") asked:
                            </div>
                            <div class="p-3 bg-white rounded-3 border text-dark">
                                @inq.Message
                            </div>
                        </div>

                        <!-- Response Section -->
                        @if (!string.IsNullOrEmpty(inq.Response))
                        {
                            <div class="ps-md-4">
                                <div class="small fw-bold text-success mb-1">
                                    <i class="bi bi-check-circle-fill"></i> Representative Response (@(inq.RespondedAt?.ToString("MMM dd, yyyy h:mm tt"))):
                                </div>
                                <div class="p-3 bg-success-subtle text-dark rounded-3 border border-success-subtle">
                                    @inq.Response
                                </div>
                            </div>
                        }
                        else if (!isClient)
                        {
                            <!-- Reply Form for Agent / Seller / Admin -->
                            <div class="ps-md-4 mt-3">
                                <form asp-action="Reply" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@inq.Id" />
                                    <div class="input-group">
                                        <input type="text" name="response" class="form-control" placeholder="Write response to client..." required />
                                        <button type="submit" class="btn btn-primary fw-bold">
                                            <i class="bi bi-send me-1"></i> Send Reply
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="ps-md-4 small text-muted fst-italic">
                                <i class="bi bi-hourglass-split"></i> Awaiting response from the listing representative.
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-chat-square-dots display-4 text-muted mb-2 d-block"></i>
                <h5 class="fw-bold">No Inquiries Found</h5>
                <p class="text-muted mb-3">You don't have any active question threads.</p>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary fw-semibold">
                    <i class="bi bi-grid me-1"></i> Browse Properties
                </a>
            </div>
        }
    </div>
</div>
