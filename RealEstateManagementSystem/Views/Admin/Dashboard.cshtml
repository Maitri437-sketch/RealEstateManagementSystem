@model RealEstateManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-speedometer2 me-2"></i> Admin Portal</h1>
            <p class="text-white-50 mb-0">System performance metrics, property approval queue, and user management</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="PendingApprovals" class="btn btn-warning text-dark fw-bold position-relative">
                <i class="bi bi-hourglass-split me-1"></i> Approvals
                @if (Model.PendingApprovals > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @Model.PendingApprovals
                    </span>
                }
            </a>
            <a asp-action="Users" class="btn btn-light text-primary fw-bold">
                <i class="bi bi-people-fill me-1"></i> Users
            </a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-bar-chart-fill me-1"></i> Reports
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Counter Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Total Properties</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalProperties</h3>
                    </div>
                    <div class="stat-icon bg-primary text-white">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    <span class="text-success fw-bold">@Model.ApprovedProperties</span> Approved &middot;
                    <span class="text-warning fw-bold">@Model.PendingApprovals</span> Pending
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Pending Review</span>
                        <h3 class="fw-bold text-warning mt-1 mb-0">@Model.PendingApprovals</h3>
                    </div>
                    <div class="stat-icon bg-warning text-dark">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <a asp-action="PendingApprovals" class="text-primary text-decoration-none fw-semibold">
                        Review pending listings <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Total Users</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalUsers</h3>
                    </div>
                    <div class="stat-icon bg-success text-white">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    <span>@Model.AgentCount Agents</span> &middot;
                    <span>@Model.SellerCount Sellers</span> &middot;
                    <span>@Model.ClientCount Clients</span>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Appointments</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalAppointments</h3>
                    </div>
                    <div class="stat-icon bg-info text-white">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    <span>@Model.TotalInquiries Inquiries logged</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Shortcuts -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Properties" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-list-check me-1"></i> All Properties (@Model.TotalProperties)
                    </a>
                    <a asp-action="Properties" asp-route-status="Approved" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-check-circle me-1"></i> Approved Listings (@Model.ApprovedProperties)
                    </a>
                    <a asp-action="Properties" asp-route-status="Pending" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-hourglass-split me-1"></i> Pending Queue (@Model.PendingApprovals)
                    </a>
                    <a asp-action="Properties" asp-route-status="Rejected" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-x-circle me-1"></i> Rejected Listings (@Model.RejectedProperties)
                    </a>
                    <a asp-action="Users" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-person-gear me-1"></i> Manage User Accounts (@Model.TotalUsers)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row: Recent Properties & Recent Appointments -->
    <div class="row g-4">
        <!-- Recent Properties -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-houses text-primary me-2"></i> Recent Listings</h5>
                    <a asp-action="Properties" class="small text-primary text-decoration-none fw-semibold">View All</a>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-muted">
                                    <th>Property</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Seller</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var property in Model.RecentProperties)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="fw-bold text-dark text-decoration-none">
                                                @property.Title
                                            </a>
                                            <small class="text-muted d-block">@property.City, @property.State &middot; @property.PropertyType</small>
                                        </td>
                                        <td class="fw-bold text-primary">$@property.Price.ToString("N0")</td>
                                        <td>
                                            <span class="badge @(property.Status switch { "Approved" => "bg-success", "Pending" => "bg-warning text-dark", "Rejected" => "bg-danger", _ => "bg-secondary" })">
                                                @property.Status
                                            </span>
                                        </td>
                                        <td class="small">@(property.Seller?.FullName ?? "Owner")</td>
                                        <td class="text-end">
                                            <a asp-controller="Property" asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Appointments -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event text-info me-2"></i> Recent Tours</h5>
                    <a asp-controller="Appointment" asp-action="Index" class="small text-primary text-decoration-none fw-semibold">View All</a>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (Model.RecentAppointments.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var appt in Model.RecentAppointments)
                            {
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-dark small">@(appt.Property?.Title ?? "Property Tour")</strong>
                                        <span class="badge @(appt.Status switch { "Confirmed" => "bg-success", "Completed" => "bg-primary", "Cancelled" => "bg-danger", _ => "bg-warning text-dark" }) small">
                                            @appt.Status
                                        </span>
                                    </div>
                                    <div class="small text-muted mb-1">
                                        <i class="bi bi-clock me-1"></i> @appt.AppointmentDate.ToString("MMM dd, yyyy @ h:mm tt")
                                    </div>
                                    <div class="small text-secondary">
                                        Client: <strong>@(appt.Client?.FullName ?? "Client")</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small py-3 mb-0 text-center">No appointments booked yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
