@{
    ViewData["Title"] = "User Management";
    var userList = ViewBag.UserList as List<Tuple<RealEstateManagementSystem.Models.Users, string>> ?? new List<Tuple<RealEstateManagementSystem.Models.Users, string>>();
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-people-fill me-2"></i> User Management</h1>
            <p class="text-white-50 mb-0">Manage system accounts, activate/deactivate access, and modify assigned roles</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Contact</th>
                        <th>Current Role</th>
                        <th>Status</th>
                        <th>Member Since</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in userList)
                    {
                        var user = item.Item1;
                        var role = item.Item2;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 14px;">
                                        @((user.FullName.Length > 0 ? user.FullName.Substring(0, 1) : "U").ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i> @(string.IsNullOrEmpty(user.PhoneNumber) ? "Not Provided" : user.PhoneNumber)</small>
                                <small class="text-muted d-block"><i class="bi bi-geo-alt me-1"></i> @(string.IsNullOrEmpty(user.Address) ? "Not Provided" : user.Address)</small>
                            </td>
                            <td>
                                <span class="badge @(role switch { "Admin" => "bg-danger", "Agent" => "bg-info text-dark", "Seller" => "bg-success", _ => "bg-primary" }) px-3 py-2">
                                    @role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="bi bi-x-circle-fill me-1"></i> Deactivated
                                    </span>
                                }
                            </td>
                            <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <!-- Change Role Form -->
                                    <form asp-action="ChangeUserRole" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <div class="input-group input-group-sm">
                                            <select name="newRole" class="form-select form-select-sm" style="width: 100px;">
                                                <option value="Client" selected="@(role == "Client")">Client</option>
                                                <option value="Agent" selected="@(role == "Agent")">Agent</option>
                                                <option value="Seller" selected="@(role == "Seller")">Seller</option>
                                                <option value="Admin" selected="@(role == "Admin")">Admin</option>
                                            </select>
                                            <button type="submit" class="btn btn-outline-secondary" title="Update Role">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </div>
                                    </form>

                                    <!-- Toggle Active Form -->
                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline ms-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                                title="@(user.IsActive ? "Deactivate Account" : "Activate Account")"
                                                onclick="return confirm('Are you sure you want to change this user status?');">
                                            <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
