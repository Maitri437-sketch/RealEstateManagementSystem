<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstate Management System</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Real Estate CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light border-bottom">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-buildings-fill text-primary fs-3"></i>
                    <span>RealEstate</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Property" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Properties
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-envelope me-1"></i> Contact
                            </a>
                        </li>
                    </ul>

                    <!-- Authentication / User Menu -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast / Alert Messages Container -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Modern Footer -->
    <footer class="footer-main">
        <div class="container">
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3 text-white">
                        <i class="bi bi-buildings-fill text-primary fs-3"></i>
                        <span class="fs-4 fw-bold">RealEstate</span>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        Your trusted partner in discovering, buying, renting, and selling premier real estate properties. Connecting verified buyers, certified agents, and property sellers seamlessly.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Property" asp-action="Index">Browse Properties</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Support</a></li>
                        <li><a asp-controller="Comparison" asp-action="Index">Property Comparison</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Property Categories</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Property" asp-action="Index" asp-route-propertyType="Villa">Luxury Villas</a></li>
                        <li><a asp-controller="Property" asp-action="Index" asp-route-propertyType="Apartment">Modern Apartments</a></li>
                        <li><a asp-controller="Property" asp-action="Index" asp-route-propertyType="House">Single-Family Houses</a></li>
                        <li><a asp-controller="Property" asp-action="Index" asp-route-propertyType="Commercial">Commercial Spaces</a></li>
                        <li><a asp-controller="Property" asp-action="Index" asp-route-propertyType="Condo">City Condominiums</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Contact Us</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small text-secondary">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-primary"></i> 100 Realty Boulevard, Metro City
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-primary"></i> +1 (800) 555-REAL (7325)
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-primary"></i> support@@realestate.com
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-fill text-primary"></i> Mon - Sat: 9:00 AM - 6:00 PM
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year RealEstate Management System. All rights reserved.</p>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <span>&middot;</span>
                    <a href="#">Terms of Service</a>
                    <span>&middot;</span>
                    <a href="#">Security</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS & jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
