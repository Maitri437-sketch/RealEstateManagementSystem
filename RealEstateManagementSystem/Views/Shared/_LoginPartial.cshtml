@using Microsoft.AspNetCore.Identity
@using RealEstateManagementSystem.Models
@inject SignInManager<Users> SignInManager
@inject UserManager<Users> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? "Member";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (!string.IsNullOrEmpty(currentUser?.ProfilePictureUrl))
            {
                <img src="@currentUser.ProfilePictureUrl" alt="@fullName" class="rounded-circle border" width="32" height="32" style="object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 14px;">
                    @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                </div>
            }
            <span class="fw-semibold">@fullName</span>
            <span class="badge @(primaryRole switch { "Admin" => "bg-danger", "Agent" => "bg-info text-dark", "Seller" => "bg-success", _ => "bg-primary" })">@primaryRole</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
            <li>
                <h6 class="dropdown-header">Signed in as <strong>@fullName</strong></h6>
            </li>
            <li><hr class="dropdown-divider"></li>

            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 text-danger me-2"></i> Admin Dashboard
                    </a>
                </li>
            }
            @if (User.IsInRole("Agent"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Agent" asp-action="Dashboard">
                        <i class="bi bi-briefcase text-info me-2"></i> Agent Dashboard
                    </a>
                </li>
            }
            @if (User.IsInRole("Seller"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Seller" asp-action="Dashboard">
                        <i class="bi bi-house-door text-success me-2"></i> Seller Dashboard
                    </a>
                </li>
            }
            @if (User.IsInRole("Client"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Client" asp-action="Dashboard">
                        <i class="bi bi-person-workspace text-primary me-2"></i> Client Dashboard
                    </a>
                </li>
            }

            <li>
                <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-gear text-secondary me-2"></i> My Profile
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">
                    <i class="bi bi-heart text-danger me-2"></i> My Wishlist
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Comparison" asp-action="Index">
                    <i class="bi bi-arrow-left-right text-info me-2"></i> Compare Properties
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="nav-link text-dark fw-semibold" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i> Register
        </a>
    </li>
}
</ul>
