@model List<RealEstateManagementSystem.Models.Wishlist>
@{
    ViewData["Title"] = "My Saved Wishlist";
}

<!-- Luxury Page Header -->
<div class="luxury-page-header">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">
                <i class="bi bi-heart-fill me-1"></i> Personal Favorites
            </span>
            <h1 class="h2 fw-bold mb-1">My Saved Properties</h1>
            <p class="text-white-50 mb-0">Review, compare, and schedule tours for properties you've shortlisted</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Property" asp-action="Index" class="btn btn-light text-primary fw-bold shadow-sm">
                <i class="bi bi-search me-1"></i> Browse More Properties
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var property = item.Property;
                if (property == null) continue;

                var mainImage = property.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                ?? property.Images.FirstOrDefault()?.ImageUrl
                                ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                <div class="col-md-6 col-lg-4">
                    <div class="property-card">
                        <div class="property-image-wrapper">
                            <img src="@mainImage" alt="@property.Title" loading="lazy" />
                            <div class="property-badge-type">
                                <span class="property-badge @(property.ListingType == "Sale" ? "badge-sale" : "badge-rent")">
                                    For @property.ListingType
                                </span>
                                @if (property.IsFeatured)
                                {
                                    <span class="property-badge badge-featured">
                                        <i class="bi bi-star-fill"></i> Featured
                                    </span>
                                }
                            </div>
                            <div class="property-actions-overlay">
                                <form asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@property.Id" />
                                    <button type="submit" class="btn-action-round active" title="Remove from Wishlist">
                                        <i class="bi bi-heart-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="property-price">
                                    $@property.Price.ToString("N0")
                                    @if (property.ListingType == "Rent")
                                    {
                                        <small class="fs-6 text-muted fw-normal">/ mo</small>
                                    }
                                </span>
                                <span class="badge bg-light text-secondary border">@property.PropertyType</span>
                            </div>

                            <h5 class="fw-bold mb-1 text-truncate">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="text-dark text-decoration-none">
                                    @property.Title
                                </a>
                            </h5>

                            <p class="text-muted small mb-3 text-truncate">
                                <i class="bi bi-geo-alt text-danger me-1"></i> @property.Address, @property.City
                            </p>

                            <div class="property-meta-specs mb-3">
                                <span><i class="bi bi-door-closed text-primary"></i> @property.Bedrooms Beds</span>
                                <span><i class="bi bi-droplet text-info"></i> @property.Bathrooms Baths</span>
                                <span><i class="bi bi-bounding-box text-secondary"></i> @property.AreaSqFt.ToString("N0") sqft</span>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="btn btn-primary w-100 btn-sm fw-semibold">
                                    View Details
                                </a>
                                <a asp-controller="Appointment" asp-action="Book" asp-route-propertyId="@property.Id" class="btn btn-outline-secondary btn-sm" title="Schedule Tour">
                                    <i class="bi bi-calendar-event"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                <i class="bi bi-heart"></i>
            </div>
            <h4 class="fw-bold">Your Saved Wishlist is Empty</h4>
            <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">You haven't saved any luxury properties to your favorites yet. Start exploring listings and click the heart icon on any card to save it for quick access.</p>
            <div>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary fw-semibold px-4 shadow-sm">
                    <i class="bi bi-search me-1"></i> Browse Properties Now
                </a>
            </div>
        </div>
    }
</div>
