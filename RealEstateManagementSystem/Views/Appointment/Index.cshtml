@model List<RealEstateManagementSystem.Models.Appointment>
@using System.Security.Claims
@{
    ViewData["Title"] = "Property Tours & Appointments";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
    var isAgent = User.IsInRole("Agent");
    var isSeller = User.IsInRole("Seller");
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-calendar2-check-fill me-2"></i> Scheduled Tours</h1>
            <p class="text-white-50 mb-0">Manage property viewing appointments and tour requests</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Property" asp-action="Index" class="btn btn-light text-primary fw-bold">
                <i class="bi bi-search me-1"></i> Browse Properties
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted">
                            <th>Property</th>
                            @if (!User.IsInRole("Client"))
                            {
                                <th>Client Details</th>
                            }
                            <th>Scheduled Date & Time</th>
                            <th>Status</th>
                            <th>Representative</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            var img = appt.Property?.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl
                                      ?? appt.Property?.Images.FirstOrDefault()?.ImageUrl
                                      ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@img" class="rounded-3" style="width: 70px; height: 50px; object-fit: cover;" alt="Property">
                                        <div>
                                            <a asp-controller="Property" asp-action="Details" asp-route-id="@appt.PropertyId" class="fw-bold text-dark text-decoration-none">
                                                @(appt.Property?.Title ?? "Property Listing")
                                            </a>
                                            <small class="text-muted d-block"><i class="bi bi-geo-alt"></i> @(appt.Property?.Address), @(appt.Property?.City)</small>
                                        </div>
                                    </div>
                                </td>
                                @if (!User.IsInRole("Client"))
                                {
                                    <td class="small">
                                        <div class="fw-bold text-dark">@(appt.Client?.FullName ?? "Prospective Client")</div>
                                        <div class="text-muted">@appt.Client?.Email</div>
                                        <div class="text-muted">@appt.Client?.PhoneNumber</div>
                                    </td>
                                }
                                <td class="small">
                                    <strong class="text-dark d-block"><i class="bi bi-calendar3 text-primary me-1"></i> @appt.AppointmentDate.ToString("MMM dd, yyyy")</strong>
                                    <span class="text-muted"><i class="bi bi-clock text-info me-1"></i> @appt.AppointmentDate.ToString("h:mm tt")</span>
                                </td>
                                <td>
                                    <span class="badge @(appt.Status switch { "Confirmed" => "bg-success", "Completed" => "bg-primary", "Cancelled" => "bg-danger", _ => "bg-warning text-dark" }) px-3 py-1">
                                        @appt.Status
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @(appt.Agent != null ? appt.Agent.FullName : "Agent will be assigned")
                                </td>
                                <td class="small text-muted" style="max-width: 180px;">
                                    @(string.IsNullOrEmpty(appt.Notes) ? "-" : appt.Notes)
                                </td>
                                <td class="text-end">
                                    @if (isAdmin || isAgent || isSeller)
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <select name="status" class="form-select form-select-sm" style="width: 120px;" onchange="this.form.submit()">
                                                <option value="Pending" selected="@(appt.Status == "Pending")">Pending</option>
                                                <option value="Confirmed" selected="@(appt.Status == "Confirmed")">Confirm</option>
                                                <option value="Completed" selected="@(appt.Status == "Completed")">Completed</option>
                                                <option value="Cancelled" selected="@(appt.Status == "Cancelled")">Cancel</option>
                                            </select>
                                        </form>
                                    }
                                    else if (appt.Status != "Cancelled" && appt.Status != "Completed")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancel this tour request?');">
                                                Cancel Tour
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x display-4 text-muted mb-2 d-block"></i>
                <h5 class="fw-bold">No Scheduled Tours Found</h5>
                <p class="text-muted mb-3">You don't have any appointments currently scheduled.</p>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary fw-semibold">
                    <i class="bi bi-grid me-1"></i> Browse Properties to Tour
                </a>
            </div>
        }
    </div>
</div>
