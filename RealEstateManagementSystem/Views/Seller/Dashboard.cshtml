@model RealEstateManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Seller Dashboard";
}

<div class="bg-primary text-white py-4 mb-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-house-door-fill me-2"></i> Seller Workspace</h1>
            <p class="text-white-50 mb-0">Welcome back, @Model.UserName! Manage your listings, track approval status, and view prospective buyers</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Property" asp-action="Create" class="btn btn-light text-primary fw-bold">
                <i class="bi bi-plus-circle-fill me-1"></i> Add Property Listing
            </a>
            <a asp-action="Properties" class="btn btn-outline-light">
                <i class="bi bi-list-ul me-1"></i> All My Listings
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Stat Counter Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">My Total Listings</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.MyPropertiesCount</h3>
                    </div>
                    <div class="stat-icon bg-primary text-white">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Active & Approved</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">@Model.ApprovedProperties</h3>
                    </div>
                    <div class="stat-icon bg-success text-white">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Pending Review</span>
                        <h3 class="fw-bold text-warning mt-1 mb-0">@Model.PendingApprovals</h3>
                    </div>
                    <div class="stat-icon bg-warning text-dark">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Viewing Inquiries</span>
                        <h3 class="fw-bold text-info mt-1 mb-0">@Model.TotalAppointments</h3>
                    </div>
                    <div class="stat-icon bg-info text-white">
                        <i class="bi bi-calendar2-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- My Listings Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-house-check text-primary me-2"></i> My Property Listings</h5>
            <a asp-controller="Property" asp-action="Create" class="btn btn-primary btn-sm fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> New Listing
            </a>
        </div>

        @if (Model.RecentProperties.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted">
                            <th>Property</th>
                            <th>Offer</th>
                            <th>Price</th>
                            <th>Approval Status</th>
                            <th>Assigned Agent</th>
                            <th>Created On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var property in Model.RecentProperties)
                        {
                            var img = property.Images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? property.Images.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@img" class="rounded-3" style="width: 70px; height: 50px; object-fit: cover;" alt="@property.Title">
                                        <div>
                                            <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="fw-bold text-dark text-decoration-none">
                                                @property.Title
                                            </a>
                                            <small class="text-muted d-block"><i class="bi bi-geo-alt"></i> @property.City, @property.State &middot; @property.PropertyType</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge @(property.ListingType == "Sale" ? "bg-success" : "bg-info")">For @property.ListingType</span></td>
                                <td class="fw-bold text-primary">$@property.Price.ToString("N0")</td>
                                <td>
                                    @if (property.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved & Live
                                        </span>
                                    }
                                    else if (property.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> Awaiting Review
                                        </span>
                                    }
                                    else if (property.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Needs Revision
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@property.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(property.Agent != null ? property.Agent.FullName : "Admin will assign")
                                </td>
                                <td class="small text-muted">@property.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@property.Id" class="btn btn-outline-secondary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Property" asp-action="Edit" asp-route-id="@property.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="Property" asp-action="Delete" asp-route-id="@property.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="bi bi-houses display-4 text-muted mb-2"></i>
                <p class="text-muted">You haven't listed any properties yet.</p>
                <a asp-controller="Property" asp-action="Create" class="btn btn-primary btn-sm fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> List Your First Property
                </a>
            </div>
        }
    </div>

    <!-- Viewing Requests & Inquiries -->
    <div class="row g-4">
        <!-- Tour Requests -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-calendar-event text-primary me-2"></i> Upcoming Tour Requests</h5>
                @if (Model.RecentAppointments.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var appt in Model.RecentAppointments)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark small">@(appt.Property?.Title ?? "Property")</strong>
                                    <span class="badge @(appt.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">@appt.Status</span>
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-calendar3"></i> @appt.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")
                                </div>
                                <div class="small text-secondary">
                                    Prospective Buyer: <strong>@(appt.Client?.FullName ?? "Client")</strong>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small py-3 mb-0 text-center">No viewing tours requested yet.</p>
                }
            </div>
        </div>

        <!-- Inquiries Received -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-chat-left-dots text-info me-2"></i> Questions & Inquiries</h5>
                @if (Model.RecentInquiries.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var inq in Model.RecentInquiries)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark small">@inq.Subject</strong>
                                    <span class="badge @(inq.Status == "Responded" ? "bg-success" : "bg-warning text-dark")">@inq.Status</span>
                                </div>
                                <small class="text-muted d-block mb-1">Listing: <strong>@(inq.Property?.Title)</strong></small>
                                <p class="text-secondary small mb-0 fst-italic">"@inq.Message"</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small py-3 mb-0 text-center">No inquiries received yet.</p>
                }
            </div>
        </div>
    </div>
</div>
